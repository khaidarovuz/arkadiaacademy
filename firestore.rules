rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Courses collection
    match /courses/{courseId} {
      allow read: if true;
      allow write: if true;
    }

    // News collection
    match /news/{newsId} {
      allow read: if true;
      allow write: if true;
    }

    // Gallery collection
    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if true;
    }

    // Applications CRM
    match /applications/{applicationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Test connection doc
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
